# Copy to .env (gitignored) and adjust. Only EXPO_PUBLIC_* values reach the JS bundle.

# emulator | dev | staging | prod
EXPO_PUBLIC_FYT_ENV=emulator

# Where the Firebase Emulator Suite runs. Empty = 10.0.2.2 (Android emulator) / 127.0.0.1 (iOS simulator).
# On a physical phone, set your Mac's LAN IP (see README: the emulators must listen on the LAN).
EXPO_PUBLIC_FYT_EMULATOR_HOST=

# DEV ONLY. 1 = in-memory backend, no native Firebase: click through the UI (works in Expo Go). OTP is 123456.
EXPO_PUBLIC_FYT_AUTH_BYPASS=0
